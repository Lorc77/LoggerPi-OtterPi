OTTERPI_HOST=127.0.0.1
OTTERPI_PORT=8090

OTTERPI_TOKEN=<dein-token>

OTTERPI_STATE_DIR=/var/lib/loggerpi-otterpi
OTTERPI_DATABASE=/var/lib/loggerpi-otterpi/batches.sqlite3
OTTERPI_CONFIG_DIR=/var/lib/loggerpi-otterpi/config

# Python Path für flache Deploy-Struktur
PYTHONPATH=/opt/loggerpi-otterpi:/opt/loggerpi-otterpi/model

# Phase B (Alerting) – später aktivieren:
# OTTERPI_ALERT_DB=/var/lib/loggerpi-otterpi/alerts.sqlite3
# OTTERPI_ALERT_INTERVAL_SECONDS=300
