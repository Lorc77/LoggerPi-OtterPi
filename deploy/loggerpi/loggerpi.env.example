LOGGERPI_ID=loggerpi-001
OTTERPI_URL=https://loggerpi.makki.route64.de/api/v1/batches

LOGGERPI_INTERVAL_SECONDS=900

LOGGERPI_TOKEN=<dein-token>

LOGGERPI_STATE_DIR=/var/lib/loggerpi-otterpi
LOGGERPI_QUEUE_FILE=/var/lib/loggerpi-otterpi/queue.jsonl
LOGGERPI_SEQUENCE_FILE=/var/lib/loggerpi-otterpi/sequence

# Python Path für flache Deploy-Struktur
PYTHONPATH=/opt/loggerpi-otterpi:/opt/loggerpi-otterpi/model

# MEMMERT HPP260 Klimaschränke (AtmoWEB-Geräte)
ATMOWEB_101_HOST=141.51.190.101
ATMOWEB_102_HOST=141.51.190.102

# Freezer-Reader (Standard: aktiviert)
LOGGERPI_FREEZER_ENABLED=1

# MEMMERT IPP300 (serielle Verbindung)
MEMMERT_IPP300_LINKS_PORT=/dev/memmert_ipp300_links
MEMMERT_IPP300_LINKS_ADDRESS=1

MEMMERT_IPP300_RECHTS_PORT=/dev/memmert_ipp300_rechts
MEMMERT_IPP300_RECHTS_ADDRESS=2

# MEMMERT IPP300 (Standard: deaktiviert, da neue Datenquelle)
LOGGERPI_MEMMERT_ENABLED=0

# ThingSpeak-Injektion (semi-redundanter Speicher, optional; Standard: deaktiviert)
# 1 = aktiviert, 0 = deaktiviert
LOGGERPI_THINGSPEAK_ENABLED=0

# ThingSpeak Channel-ID und Write API Key
LOGGERPI_THINGSPEAK_CHANNEL_ID=2068639
LOGGERPI_THINGSPEAK_API_KEY=DEIN_WRITE_API_KEY