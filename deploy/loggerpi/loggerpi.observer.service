[Unit]
Description=LoggerPi Observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ZOOLOGY-observ
Group=ZOOLOGY-observ
WorkingDirectory=/opt/loggerpi-otterpi
EnvironmentFile=/etc/loggerpi-otterpi/loggerpi.env
Environment="PYTHONPATH=/opt/loggerpi-otterpi:/opt/loggerpi-otterpi/model"
ExecStart=/usr/bin/python3 -m loggerpi_observer
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
